# ==============================================================================
# GridWise Energy Optimization Service - Environment Configuration
# ==============================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# LLM Provider Configuration
# Supported providers: "openai", "anthropic", "openrouter", "gemini", "rule_based", "auto"
# Default is "auto" (automatically detects available API keys, falls back to zero-latency rule_based)
LLM_PROVIDER=auto
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=15.0

# Optional API Keys (Set at least one if LLM_PROVIDER is not rule_based)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LLM_API_KEY=
LLM_BASE_URL=

# Optimization Solver Configuration
# Supported solvers: "CBC" (Coin-OR CBC MILP - Recommended), "SCIP", "GLOP"
OPTIMIZER_SOLVER=CBC
OPTIMIZER_TIME_LIMIT_SECONDS=5.0
